#!/usr/bin/env bash
# Updated: 31 October 2026, 1:20 AM MDT
# gitBinUpdate — refresh repo files in an existing $HOME/bin checkout from the public HTTPS URL.
#
# Overwrites files that are in the repo, except anything under archive/.
# Before replacing a file whose content or mode differs, archives the local copy
# as <name>.YYYYMMDD_HHMMSS (Mountain Time).
# After writing, restores the executable bit on any file that starts with a shebang.
# Leaves every other file in the directory alone. Does not git clean, and does
# not reset --hard.
# Does not read or write SSH keys or SSH config.
# Does not create a checkout.
# If the origin is the SSH form of this repository, it is rewritten to HTTPS.
# A fetch of the public repository does not need a login or an SSH key.

set -euo pipefail

ColorReset='\033[0m'
IWhite='\033[0;97m'
IYellow='\033[0;93m'
ICyan='\033[0;96m'
IGreen='\033[0;92m'
IRed='\033[0;91m'
IPurple='\033[0;95m'

REV="20261031_0120"
DEFAULT_BRANCH="main"
DEFAULT_REMOTE="https://github.com/eckirchn/Bash.git"
TZ_MT="America/Denver"

die() {
    echo -e "${IRed}$*${ColorReset}" >&2
    exit 1
}

fnDisplayRevision() {
    echo -e "${IWhite}Script Revision:${IYellow}  ${REV}${ColorReset}"
    echo -e "${IPurple}  Updates over HTTPS. Skips archive/. Archives differing files. Restores +x.${ColorReset}"
    echo
}

usage() {
    cat <<'EOF'
Usage: gitBinUpdate [directory]

  directory    Where the scripts live. Default: $HOME/bin

The directory must already be a checkout of this repository.
This script does not clone and does not create a checkout.
Files already there that are not in the repo are not removed.
Files that are in the repo are replaced from the public HTTPS URL.
Anything under archive/ is skipped and is never downloaded or updated.
A local file whose content or mode differs is first renamed to
  <name>.YYYYMMDD_HHMMSS   (Mountain Time)
After the update, any file that starts with a shebang is made executable.
Does not change SSH keys, SSH config, or git settings outside that directory.
If the origin is the SSH form of this repository, it is rewritten to HTTPS.
A fetch does not need a login or an SSH key.

  GIT_BIN_BRANCH   Default: main

First install:

  git clone https://github.com/eckirchn/Bash.git "$HOME/bin"

Then:

  gitBinUpdate
  gitBinUpdate "$HOME/bin"
EOF
}

fnClientFamily() {
    local id
    if [[ -r /etc/os-release ]]; then
        id=$(awk -F= '$1=="ID" { gsub(/"/, "", $2); print $2; exit }' /etc/os-release)
        case "$id" in
            fedora|rhel|centos|almalinux|rocky) echo fedora; return ;;
            ubuntu) echo ubuntu; return ;;
            raspbian) echo raspberrypi; return ;;
            debian)
                if [[ -f /etc/rpi-issue ]]; then
                    echo raspberrypi
                    return
                fi
                if [[ -f /proc/device-tree/model ]] && grep -qi raspberry /proc/device-tree/model 2>/dev/null; then
                    echo raspberrypi
                    return
                fi
                echo debian
                return
                ;;
        esac
    fi
    echo linux
}

fnInstallHint() {
    case "$(fnClientFamily)" in
        fedora) echo "sudo dnf install git" ;;
        ubuntu|debian|raspberrypi) echo "sudo apt update && sudo apt install git" ;;
        *) echo "Install git. Fedora: sudo dnf install git. Ubuntu, Debian, Raspberry Pi OS: sudo apt install git." ;;
    esac
}

fnSlug() {
    local url=$1
    url=${url%.git}
    url=${url%/}
    if [[ "$url" =~ ^[A-Za-z0-9._+-]+@[^:]+:(.+)$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return
    fi
    if [[ "$url" =~ ^[A-Za-z][A-Za-z0-9+.-]*://([^/]*)/(.+)$ ]]; then
        printf '%s\n' "${BASH_REMATCH[2]}"
        return
    fi
    printf '%s\n' "$url"
}

fnSameRepo() {
    local a b
    a=$(fnSlug "$1" | tr '[:upper:]' '[:lower:]')
    b=$(fnSlug "$2" | tr '[:upper:]' '[:lower:]')
    [[ "$a" == "$b" ]]
}

fnResolveDir() {
    local requested=$1
    local resolved home_resolved
    if [[ ! -d "$requested" ]]; then
        die "${requested} does not exist. First install: git clone https://github.com/eckirchn/Bash.git \"\$HOME/bin\""
    fi
    resolved=$(cd "$requested" && pwd -P)
    home_resolved=$(cd "$HOME" && pwd -P)
    if [[ "$resolved" == "/" || "$resolved" == "$home_resolved" ]]; then
        die "Refusing to use ${resolved}. Use a directory such as \$HOME/bin."
    fi
    printf '%s\n' "$resolved"
}

fnRequireCheckout() {
    local bin=$1
    local current
    if [[ -f "${bin}/.git" ]]; then
        die "${bin}/.git is a file, not a checkout. Not touching it."
    fi
    if [[ ! -d "${bin}/.git" ]]; then
        die "${bin} is not a git checkout. First install: git clone https://github.com/eckirchn/Bash.git \"\$HOME/bin\""
    fi
    if ! git -C "$bin" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        die "${bin} has a .git directory this git does not understand. Not touching it."
    fi
    current=$(git -C "$bin" remote get-url origin 2>/dev/null || true)
    if [[ -z "$current" ]]; then
        die "${bin} has no origin. First install: git clone https://github.com/eckirchn/Bash.git \"\$HOME/bin\""
    fi
    if ! fnSameRepo "$current" "$DEFAULT_REMOTE"; then
        die "${bin} already tracks ${current}. Refusing to switch it to ${DEFAULT_REMOTE}."
    fi
}

fnEnsureHttps() {
    local bin=$1
    local current
    current=$(git -C "$bin" remote get-url origin)
    if [[ "$current" == "$DEFAULT_REMOTE" ]]; then
        return 0
    fi
    echo -e "${IWhite}Rewriting origin to ${ICyan}${DEFAULT_REMOTE}${ColorReset}"
    git -C "$bin" remote set-url origin "$DEFAULT_REMOTE"
}

fnSkipPath() {
    local path=$1
    [[ "$path" == archive || "$path" == archive/* ]]
}

fnLocalDiffers() {
    local bin=$1 branch=$2 path=$3
    local localfile="${bin}/${path}"
    # Content difference
    if ! git -C "$bin" diff --quiet "origin/${branch}" -- "$path" 2>/dev/null; then
        return 0
    fi
    # Mode difference (e.g. +x lost or gained)
    local wantmode localmode
    wantmode=$(git -C "$bin" ls-tree "origin/${branch}" -- "$path" | awk '{print $1}')
    if [[ -f "$localfile" ]]; then
        if [[ -x "$localfile" ]]; then
            localmode=100755
        else
            localmode=100644
        fi
        if [[ "$wantmode" != "$localmode" ]]; then
            return 0
        fi
    fi
    return 1
}

fnArchiveIfDifferent() {
    local bin=$1 branch=$2 path=$3
    local localfile="${bin}/${path}"
    if [[ ! -f "$localfile" ]]; then
        return 0
    fi
    if ! fnLocalDiffers "$bin" "$branch" "$path"; then
        return 0
    fi
    local stamp archive n=1
    stamp=$(TZ="$TZ_MT" date +%Y%m%d_%H%M%S)
    archive="${localfile}.${stamp}"
    while [[ -e "$archive" ]]; do
        archive="${localfile}.${stamp}_${n}"
        n=$((n + 1))
    done
    echo -e "${IYellow}Archiving differing local ${ICyan}${path}${IYellow} as ${ICyan}${archive##*/}${ColorReset}"
    mv -v "$localfile" "$archive"
}

fnRestoreShebangExec() {
    local bin=$1
    local path list
    list=$(mktemp)
    git -C "$bin" ls-tree -r -z --name-only HEAD >"$list" || true
    while IFS= read -r -d '' path; do
        fnSkipPath "$path" && continue
        local f="${bin}/${path}"
        if [[ -f "$f" ]] && head -n1 "$f" 2>/dev/null | grep -q '^#!'; then
            if [[ ! -x "$f" ]]; then
                chmod +x "$f"
                echo -e "${IGreen}Restored +x on ${ICyan}${path}${ColorReset}"
            fi
        fi
    done <"$list"
    rm -f "$list"
}

fnWriteRepoFiles() {
    local bin=$1 branch=$2
    local path list
    list=$(mktemp)
    git -C "$bin" ls-tree -r -z --name-only "origin/${branch}" >"$list"
    while IFS= read -r -d '' path; do
        fnSkipPath "$path" && continue
        fnArchiveIfDifferent "$bin" "$branch" "$path"
        git -C "$bin" checkout -f "origin/${branch}" -- "$path"
    done <"$list"
    rm -f "$list"
    git -C "$bin" symbolic-ref HEAD "refs/heads/${branch}"
    git -C "$bin" reset --mixed "origin/${branch}" >/dev/null
    fnRestoreShebangExec "$bin"
}

fnGitFetch() {
    local bin=$1 branch=$2
    # Pin the https URL so a global insteadOf cannot turn it into SSH.
    git -C "$bin" -c "url.${DEFAULT_REMOTE%/*/*}/.insteadOf=${DEFAULT_REMOTE%/*/*}/" fetch origin "$branch"
}

fnShowLocalFiles() {
    local bin=$1
    local line path shown=0 status
    status=$(mktemp)
    git -C "$bin" status --porcelain=v1 --untracked-files=all >"$status"
    while IFS= read -r line; do
        [[ "$line" == \?\?* ]] || continue
        path=${line#?? }
        if [[ "$shown" -eq 0 ]]; then
            echo -e "${IWhite}Left in place, not in the repo:${ColorReset}"
            shown=1
        fi
        echo -e "${ICyan}  ${path}${ColorReset}"
    done <"$status"
    rm -f "$status"
    if [[ "$shown" -eq 0 ]]; then
        echo -e "${IWhite}No extra local files.${ColorReset}"
    fi
}

fnCountRepoFiles() {
    local bin=$1 branch=$2
    local path count=0
    while IFS= read -r path; do
        fnSkipPath "$path" && continue
        count=$((count + 1))
    done < <(git -C "$bin" ls-tree -r --name-only "origin/${branch}")
    printf '%s\n' "$count"
}

bin_arg=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -d|--dir)
            [[ $# -ge 2 ]] || die "Missing value for $1"
            bin_arg=$2
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "Unknown option: $1"
            ;;
        *)
            if [[ -n "$bin_arg" ]]; then
                die "Too many arguments: $1"
            fi
            bin_arg=$1
            shift
            ;;
    esac
done

while [[ $# -gt 0 ]]; do
    if [[ -n "$bin_arg" ]]; then
        die "Too many arguments: $1"
    fi
    bin_arg=$1
    shift
done

branch=${GIT_BIN_BRANCH:-$DEFAULT_BRANCH}

fnDisplayRevision

if ! command -v git >/dev/null 2>&1; then
    die "git is not installed. $(fnInstallHint)"
fi
[[ -n "${HOME:-}" ]] || die "HOME is not set."
[[ "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ && "$branch" != *..* ]] || die "Branch name is not usable: ${branch}"

if [[ -z "$bin_arg" ]]; then
    bin_arg="${HOME}/bin"
fi
bin=$(fnResolveDir "$bin_arg")

fnRequireCheckout "$bin"
fnEnsureHttps "$bin"
git -C "$bin" config core.autocrlf false

echo -e "${IWhite}Fetching ${ICyan}${DEFAULT_REMOTE}${IWhite} (${branch})${ColorReset}"
if ! fnGitFetch "$bin" "$branch"; then
    echo -e "${IRed}Could not fetch.${ColorReset}" >&2
    exit 1
fi

if ! git -C "$bin" rev-parse --verify --quiet "origin/${branch}" >/dev/null; then
    die "Remote has no branch ${branch}."
fi

count=$(fnCountRepoFiles "$bin" "$branch")
noun=files
if [[ "$count" -eq 1 ]]; then
    noun=file
fi
echo -e "${IWhite}Writing ${ICyan}${count}${IWhite} repo ${noun} into ${ICyan}${bin}${ColorReset}"
echo -e "${IWhite}Skipping archive/. Differing local files are archived first. Files that are not in the repo are not deleted.${ColorReset}"
fnWriteRepoFiles "$bin" "$branch"

echo -e "${IGreen}Updated the repo files.${ColorReset}"
echo
fnShowLocalFiles "$bin"
echo
echo -e "${IWhite}Next time, from any directory:${ColorReset}"
echo -e "${IYellow}  gitBinUpdate${ColorReset}"
