#!/bin/bash
# Updated: 24 November 2026, 11:40 PM MST
# BlackFrameCompile
# Encode one continuous video from the earliest start timestamp to the latest
# stop timestamp found in lq_previews. Requires h264 or h265 as the first
# argument. Does not process individual clips or respect gaps.
#
#   BlackFrameCompile h264 [work-directory]
#   BlackFrameCompile h265 [work-directory]
#
# work-directory is the folder blackframeextract made (MyClip/),
# or an older MyClip_work folder. Default is the current directory.
#
# Output sits next to the source:
#   <name>.h264.mp4
#   <name>.h265.mp4
#
# Encoder choice, decided once at startup:
#   NVIDIA NVENC when ffmpeg lists the matching encoder, a GPU answers, and a
#   one-frame probe opens it. nvidia-smi is required to succeed when that
#   command is installed. Quadro P2000 (Pascal) covers H.264 and HEVC Main10.
#   H.264: preset p7, tune hq, vbr, cq 18. H.265: preset p7, tune hq, vbr,
#   cq 20, main10, p010le. If p7 is rejected, preset hq is tried.
#   CUDA decode (-hwaccel cuda -hwaccel_output_format cuda) when NVDEC can
#   open the source codec. A failed hardware decode retries with software
#   decode and NVENC. A failed NVENC encode falls back to libx264 or libx265.
#   Otherwise the software settings are used unchanged.
#
# E5-2680 (Sandy Bridge, 8c/16t, no hardware encoder). One encode.
#
# x264: preset slow, tune film, CRF 18, high profile, 8-bit.
# x265: preset medium, CRF 20, main10, SAO off, aq-mode 3.

set -euo pipefail

ColorReset='\033[0m'
IWhite='\033[0;97m'
IYellow='\033[0;93m'
ICyan='\033[0;96m'
IGreen='\033[0;92m'
IRed='\033[0;91m'

fnDie() {
    echo -e "${IRed}$*${ColorReset}" >&2
    exit 1
}

if [[ $# -lt 1 ]]; then
    fnDie "Usage: $0 h264|h265 [work-directory]"
fi

CODEC="$1"
shift
case "$CODEC" in
    h264|h265) ;;
    *) fnDie "First argument must be h264 or h265 (got: $CODEC)" ;;
esac

# Aggregate CPU from /proc/stat. Idle includes iowait. Returns "idle total".
fnCpuSample() {
    awk '/^cpu / { print $5+$6, $2+$3+$4+$5+$6+$7+$8+$9 }' /proc/stat
}

fnWaitForCpu() {
    local limit=80
    local need=10
    local idle total prev_idle prev_total didle dtotal pct under=0
    read -r prev_idle prev_total < <(fnCpuSample)
    echo -e "${IYellow}Waiting until CPU stays under ${limit}% for ${need} seconds.${ColorReset}"
    while (( under < need )); do
        sleep 1
        read -r idle total < <(fnCpuSample)
        didle=$((idle - prev_idle))
        dtotal=$((total - prev_total))
        prev_idle=$idle
        prev_total=$total
        if (( dtotal > 0 )); then
            pct=$(( (dtotal - didle) * 100 / dtotal ))
        else
            pct=0
        fi
        if (( pct < limit )); then
            under=$((under + 1))
        else
            under=0
        fi
        printf '\r%sCPU %3d%% — under %d%% for %d of %d seconds%s   ' \
            "$IYellow" "$pct" "$limit" "$under" "$need" "$ColorReset"
    done
    printf '\r%sCPU stayed under %d%% for %d seconds. Starting.%s\n' \
        "$IGreen" "$limit" "$need" "$ColorReset"
}

fnEncoderListed() {
    local enc="$1"
    local list
    list=$(ffmpeg -hide_banner -encoders 2>/dev/null || true)
    grep -Eq "[[:space:]]${enc}[[:space:]]" <<<"$list"
}

fnProbe() {
    ffmpeg -nostdin -hide_banner -loglevel error \
        -f lavfi -i color=c=black:s=256x256:r=24:d=0.05 \
        "$@" -frames:v 1 -f null - >/dev/null 2>&1
}

fnSourceCodec() {
    local codec
    codec=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name \
        -of csv=p=0 "$SOURCE" 2>/dev/null | head -1 || true)
    codec=${codec//$'\r'/}
    printf '%s\n' "$codec"
}

# Pascal NVDEC (Quadro P2000 included): H.264, HEVC, MPEG-2, MPEG-4, VC-1, VP8, VP9.
fnNvdecOk() {
    case "$1" in
        h264|hevc|mpeg2video|mpeg4|vc1|vp8|vp9) return 0 ;;
        *) return 1 ;;
    esac
}

fnTryEncode() {
    local outfile="$1"
    local mode="$2"
    shift 2
    if [[ "$mode" == hw ]]; then
        ffmpeg -nostdin -hide_banner -stats -loglevel error \
            -hwaccel cuda -hwaccel_output_format cuda \
            "$@" \
            -threads 0 \
            -map 0:v:0 -map 0:a? \
            "${VCODEC[@]}" \
            -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv \
            -c:a copy \
            -avoid_negative_ts make_zero \
            -movflags +faststart \
            -y "$outfile"
    else
        ffmpeg -nostdin -hide_banner -stats -loglevel error \
            "$@" \
            -threads 0 \
            -map 0:v:0 -map 0:a? \
            "${VCODEC[@]}" \
            -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv \
            -c:a copy \
            -avoid_negative_ts make_zero \
            -movflags +faststart \
            -y "$outfile"
    fi
}

fnRunEncode() {
    local outfile="$1"
    shift
    if (( USE_HWACCEL )); then
        if fnTryEncode "$outfile" hw "$@"; then
            return 0
        fi
        echo -e "${IYellow}Hardware decode failed. Retrying with software decode.${ColorReset}" >&2
        USE_HWACCEL=0
        if fnTryEncode "$outfile" sw "$@"; then
            return 0
        fi
    elif fnTryEncode "$outfile" sw "$@"; then
        return 0
    fi
    if (( USE_NVENC )); then
        echo -e "${IYellow}NVENC failed. Falling back to software.${ColorReset}" >&2
        USE_NVENC=0
        VCODEC=("${VCODEC_SW[@]}")
        if fnTryEncode "$outfile" sw "$@"; then
            return 0
        fi
    fi
    fnDie "encode failed: $outfile"
}

for cmd in ffmpeg ffprobe bc; do
    command -v "$cmd" >/dev/null 2>&1 || fnDie "missing: $cmd"
done

WORKDIR=$(readlink -f "${1:-.}")
LQDIR="$WORKDIR/lq_previews"
[[ -d "$LQDIR" ]] || fnDie "No lq_previews in $WORKDIR"

fnFindSource() {
    local dir="$1"
    local stem ext f base
    stem=$(basename "$dir")
    stem=${stem%_work}
    for ext in mp4 mkv m4v mov ts avi mpg mpeg; do
        f="$dir/$stem.$ext"
        if [[ -f "$f" ]]; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    local -a found=()
    shopt -s nullglob
    for f in "$dir"/*.{mp4,mkv,m4v,mov,ts,avi,mpg,mpeg}; do
        base=$(basename "$f")
        [[ "$base" == *.clean.* || "$base" == *.h264.mp4 || "$base" == *.h265.mp4 ]] && continue
        found+=("$f")
    done
    shopt -u nullglob
    if (( ${#found[@]} == 1 )); then
        printf '%s\n' "${found[0]}"
        return 0
    fi
    if (( ${#found[@]} == 0 )); then
        fnDie "No source video in $dir"
    fi
    fnDie "More than one source video in $dir; use a folder named after the source"
}

SOURCE=$(fnFindSource "$WORKDIR")
STEM=$(basename "$SOURCE")
STEM=${STEM%.*}

# Software flags are the previous behavior. Do not retune them.
H264_SW=(
    -c:v libx264
    -preset slow
    -tune film
    -crf 18
    -profile:v high
    -pix_fmt yuv420p
)
H265_SW=(
    -c:v libx265
    -preset medium
    -crf 20
    -pix_fmt yuv420p10le
    -profile:v main10
    -tag:v hvc1
    -x265-params "aq-mode=3:qg-size=32:psy-rd=2.0:psy-rdoq=1.0:rdoq-level=2:deblock=-1,-1:sao=0:strong-intra-smoothing=0:bframes=6:rc-lookahead=40:ref=4"
)
H264_NV_P7=(
    -c:v h264_nvenc
    -preset p7
    -tune hq
    -rc vbr
    -cq 18
    -b:v 0
    -profile:v high
    -pix_fmt yuv420p
    -spatial-aq 1
    -temporal-aq 1
    -rc-lookahead 32
    -bf 3
)
H264_NV_HQ=(
    -c:v h264_nvenc
    -preset hq
    -tune hq
    -rc vbr
    -cq 18
    -b:v 0
    -profile:v high
    -pix_fmt yuv420p
    -spatial-aq 1
    -temporal-aq 1
    -rc-lookahead 32
    -bf 3
)
H265_NV_P7=(
    -c:v hevc_nvenc
    -preset p7
    -tune hq
    -rc vbr
    -cq 20
    -b:v 0
    -profile:v main10
    -pix_fmt p010le
    -tag:v hvc1
    -spatial-aq 1
    -temporal-aq 1
    -rc-lookahead 32
    -bf 3
)
H265_NV_HQ=(
    -c:v hevc_nvenc
    -preset hq
    -tune hq
    -rc vbr
    -cq 20
    -b:v 0
    -profile:v main10
    -pix_fmt p010le
    -tag:v hvc1
    -spatial-aq 1
    -temporal-aq 1
    -rc-lookahead 32
    -bf 3
)

USE_NVENC=0
USE_HWACCEL=0

if [[ "$CODEC" == h265 ]]; then
    VCODEC_SW=("${H265_SW[@]}")
    LABEL="x265 main10 medium CRF 20"
    OUTPUT="$WORKDIR/${STEM}.h265.mp4"
    NV_NAME=hevc_nvenc
    SW_NAME=libx265
else
    VCODEC_SW=("${H264_SW[@]}")
    LABEL="x264 slow tune film CRF 18"
    OUTPUT="$WORKDIR/${STEM}.h264.mp4"
    NV_NAME=h264_nvenc
    SW_NAME=libx264
fi
VCODEC=("${VCODEC_SW[@]}")

GPU_SEEN=0
if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
    GPU_SEEN=1
fi

if fnEncoderListed "$NV_NAME" && { [[ "$GPU_SEEN" -eq 1 ]] || ! command -v nvidia-smi >/dev/null 2>&1; }; then
    if [[ "$CODEC" == h265 ]]; then
        NV_P7=("${H265_NV_P7[@]}")
        NV_HQ=("${H265_NV_HQ[@]}")
        NV_LABEL_P7="NVENC hevc_nvenc p7 tune hq vbr cq 20 main10"
        NV_LABEL_HQ="NVENC hevc_nvenc hq tune hq vbr cq 20 main10"
    else
        NV_P7=("${H264_NV_P7[@]}")
        NV_HQ=("${H264_NV_HQ[@]}")
        NV_LABEL_P7="NVENC h264_nvenc p7 tune hq vbr cq 18"
        NV_LABEL_HQ="NVENC h264_nvenc hq tune hq vbr cq 18"
    fi
    if fnProbe "${NV_P7[@]}"; then
        USE_NVENC=1
        VCODEC=("${NV_P7[@]}")
        LABEL="$NV_LABEL_P7"
    elif fnProbe "${NV_HQ[@]}"; then
        USE_NVENC=1
        VCODEC=("${NV_HQ[@]}")
        LABEL="$NV_LABEL_HQ"
        echo -e "${IYellow}NVENC preset p7 was rejected. Using preset hq.${ColorReset}" >&2
    elif [[ "$GPU_SEEN" -eq 1 ]]; then
        echo -e "${IYellow}NVENC probe failed. Using ${SW_NAME}.${ColorReset}" >&2
    fi
fi

if (( USE_NVENC )) && fnNvdecOk "$(fnSourceCodec)"; then
    USE_HWACCEL=1
    LABEL="$LABEL, CUDA decode"
elif (( USE_NVENC )); then
    LABEL="$LABEL, software decode"
fi

# Collect min start and max stop from all LQ clip filenames
min_start=""
max_stop=""
shopt -s nullglob
for f in "$LQDIR"/LQ_Clip*.mp4; do
    base=$(basename "$f" .mp4)
    if [[ "$base" =~ ^LQ_Clip([0-9]+)_([0-9]+\.[0-9]+)-([0-9]+\.[0-9]+)$ ]]; then
        start="${BASH_REMATCH[2]}"
        stop="${BASH_REMATCH[3]}"
        if [[ -z "$min_start" ]] || (( $(bc -l <<< "$start < $min_start") )); then
            min_start="$start"
        fi
        if [[ -z "$max_stop" ]] || (( $(bc -l <<< "$stop > $max_stop") )); then
            max_stop="$stop"
        fi
    else
        echo -e "${IYellow}skip (bad name): $(basename "$f")${ColorReset}" >&2
    fi
done
shopt -u nullglob

if [[ -z "$min_start" || -z "$max_stop" ]]; then
    fnDie "No valid LQ clips found in $LQDIR"
fi

len=$(bc -l <<< "$max_stop - $min_start")

echo -e "${IWhite}Source:${ColorReset}  $SOURCE"
echo -e "${IWhite}Output:${ColorReset}  $OUTPUT"
echo -e "${IWhite}Range:${ColorReset}   $min_start -> $max_stop  (${len}s), ${LABEL}"

fnWaitForCpu

echo -e "${IGreen}Encoding continuous range${ColorReset}  ${min_start}–${max_stop} (${len}s)"
fnRunEncode "$OUTPUT" -ss "$min_start" -i "$SOURCE" -t "$len"

echo -e "${IGreen}Done:${ColorReset} $OUTPUT"
