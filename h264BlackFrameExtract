	local _iLogFile="$1"
	local _oFileGenClipsScript_LQ="$2"
	local _oFileGenClipsScript_HQ="$3"

	local _rLine=""
	local _Clip=""
	local _tStart=""
	local _tEnd=""
	local _tLength=""

	local _oFile=""
	local _ClipLength=""
	local _ClipPreScanTime=""
	local _ClipPreStart=""
	local _txtStartClip1=""
	local _txtStartClip2=""

	if [ -f "$_oLogFile" ]; then
		rm -Rf "$_oLogFile" 2>&1
	fi

	# Loop Through ffmpeg Report Log for Black Frame Information
	while IFS='' read -r _rLine; do
		echo
		echo -e "Processing Line: [ "$IYellow$_rLine$ColorReset" ]"

		# Extract data from Read Line
		_Clip=$(echo $_rLine |  grep -oP '(?<=Clip:).*' | cut -f1 -d ' ')
		_tStart=$(echo $_rLine |  grep -oP '(?<=tStart:).*' | cut -f1 -d ' ')
		_tStop=$(echo $_rLine |  grep -oP '(?<=tStop:).*' | cut -f1 -d ' ')
		_ClipLength=$(bc -l <<< "$_tStop - $_tStart")
		_ClipPreScanTime=10 # Start search 10 seconds early to speed up search but maintain frame accuracy

		if (( $(bc -l <<< "$_tStart >= $_ClipPreScanTime") )); then
			_ClipPreStart=$(bc -l <<<  "$_tStart - $_ClipPreScanTime")
		else
			_ClipPreStart=0
			_ClipPreScanTime=$_tStart
		fi

		_ClipLength=$(printf "%013.6f\n" $_ClipLength)
		_ClipPreStart=$(printf "%013.6f\n" $_ClipPreStart)

		echo -e "  Clip: "$ICyan$_Clip$ColorReset\
			", Time Start: "$IGreen$_tStart$ColorReset\
			", Stop: "$IRed$_tStop$ColorReset\
			", Length: "$IBlue$_ClipLength$ColorReset

		_oFile="Clip"$_Clip" "$_tStart" - "$_tStop" "

		# Add the clip FFmpeg command line to the batch file that will generate the clips (also display it on the screen)

		# NOTE $VAR3 = "$1" literally.  The script is executeed below and the file is sent to the script.
		# This way the Generate Video Script can be reused for different files.
		# This could be usefull if this is executed on a low quality version, but once confirmed
		# the high quality version could be referenced

		VAR3=$(echo '$iFile') # Variable used in Generation Script
		VAR4=$(echo '$oClipDir') # Variable used in Generation Script

		# Generate the Low Quality Preview Script
		echo "" >> "$_oFileGenClipsScript_LQ"
		echo "echo \"\"" >> "$_oFileGenClipsScript_LQ"
		_txtStartClip1="echo;echo -e \"$IGreen\"\"Starting Clip # $_Clip\"\"$ColorReset\""
		echo "$_txtStartClip1" >> "$_oFileGenClipsScript_LQ"

		cmdline1=$(echo "ffmpeg -hide_banner -ss $_ClipPreStart -i \"$VAR3\" -ss $_ClipPreScanTime -t $_ClipLength "\
			"-threads 1 -c:v libx264 -preset ultrafast -vf scale=-1:180 -movflags +faststart -crf 28 "\
			"-c:a copy -y \"$VAR4/LQ_$_oFile"".mp4\"")

#		echo "echo \"\"" >> "$_oFileGenClipsScript_LQ"
		echo "echo -e \"  Executing Commandline: \"\"$ICyan\"\"$cmdline1\"\"$ColorReset\"" >> "$_oFileGenClipsScript_LQ"
		echo "echo \"\"" >> "$_oFileGenClipsScript_LQ"

		echo "xterm -iconic -geometry 120x20+0+40 -e $cmdline1 &" >> "$_oFileGenClipsScript_LQ"
		echo "sleep 1" >> "$_oFileGenClipsScript_LQ"
		echo "CPUSleep" >> "$_oFileGenClipsScript_LQ"

		# Generate the High Quality Preview Script
		echo -e "" >> "$_oFileGenClipsScript_HQ"
		_txtStartClip2="echo;echo -e \"$IGreen\"\"Starting Clip # $_Clip\"\"$ColorReset\""
		echo "$_txtStartClip2" >> "$_oFileGenClipsScript_HQ"

		cmdline2=$(echo "ffmpeg -hide_banner -ss $_ClipPreStart -i \"$VAR3\" -ss $_ClipPreScanTime -t $_ClipLength "\
			"-threads 1 -c:v libx264 -preset veryfast -pix_fmt yuv420p -movflags +faststart -crf 23 "\
			"-c:a copy -y \"$VAR4/HQ_$_oFile"".mp4\"")

		echo "echo \"\"" >> "$_oFileGenClipsScript_HQ"
		echo "echo -e \"  Executing Commandline: \"\"$ICyan\"\"$cmdline2\"\"$ColorReset\"" >> "$_oFileGenClipsScript_HQ"
		echo "echo \"\"" >> "$_oFileGenClipsScript_HQ"

		echo "xterm -iconic -geometry 120x20+0+40 -e $cmdline2 &" >> "$_oFileGenClipsScript_HQ"
		echo "sleep 1" >> "$_oFileGenClipsScript_HQ"
		echo "CPUSleep" >> "$_oFileGenClipsScript_HQ"

	done < "$_iLogFile"

}


