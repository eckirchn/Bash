#!/bin/bash
# Updated: 23 October 2026, 10:25 PM MDT
# h264BlackFrameExtract — modernized for multi-threaded FFmpeg and command-line use
# Goal: detect black-frame cut points, emit LQ preview clips for review,
#       and generate a companion HQ script that re-uses the same timestamps
#       on the original source.
#
# Changes from 2018–2020 version:
#   - blackdetect instead of blackframe + full log scrape
#   - no xterm / no artificial -threads 1 / no CPU-sleep throttle
#   - FFmpeg does its own multi-threading (-threads 0)
#   - sequential (or lightly parallel) LQ generation so the old Xeon stays usable
#   - Debian-friendly dependency checks

set -euo pipefail

# ---------- colors ----------
ColorReset='\033[0m'
IWhite='\033[0;97m'
IYellow='\033[0;93m'
ICyan='\033[0;96m'
IGreen='\033[0;92m'
IRed='\033[0;91m'
IBlue='\033[0;94m'
IPurple='\033[0;95m'

fnDisplayRevision() {
    echo -e "${IWhite}Script Revision:${IYellow}  20261022_modern${ColorReset}"
    echo -e "${IPurple}  blackdetect, multi-threaded FFmpeg, no xterm, Debian-friendly${ColorReset}"
    echo
}

fnDepCheck() {
    local missing=0
    echo -e "${IWhite}Dependency check${ColorReset}"
    for cmd in ffmpeg ffprobe bc; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo -e "  $cmd: ${IGreen}OK${ColorReset}"
        else
            echo -e "  ${IRed}missing: $cmd${ColorReset}"
            echo -e "  Install: ${IYellow}sudo apt update && sudo apt install ffmpeg bc${ColorReset}"
            missing=1
        fi
    done
    if (( missing )); then
        echo -e "${IRed}Dependencies missing. Exiting.${ColorReset}"
        exit 1
    fi
    echo
}

# ---------- helpers ----------
fnGetFPS() {
    local file="$1"
    ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate \
        -of csv=p=0 "$file" | head -1
}

fnGetDuration() {
    local file="$1"
    ffprobe -v error -show_entries format=duration -of csv=p=0 "$file"
}

# ---------- blackdetect ----------
fnDetectBlackSegments() {
    local infile="$1"
    local outfile="$2"

    # Tunable thresholds — adjust per source type if needed
    local d=0.15          # min black duration (seconds)
    local pic_th=0.98     # fraction of frame that must be black
    local pix_th=0.12     # pixel darkness threshold (0–1, scaled to range)

    echo -e "${IWhite}Running blackdetect on ${ICyan}$infile${ColorReset}"
    ffmpeg -nostdin -hide_banner -loglevel info -i "$infile" \
        -vf "blackdetect=d=${d}:pic_th=${pic_th}:pix_th=${pix_th}" \
        -an -sn -f null - 2>&1 \
        | grep -E 'black_start|black_end|black_duration' \
        | sed -E 's/.*black_start:([0-9.]+).*black_end:([0-9.]+).*black_duration:([0-9.]+).*/\1 \2 \3/' \
        > "$outfile.tmp" || true

    if [[ ! -s "$outfile.tmp" ]]; then
        echo -e "${IYellow}No black segments detected. Creating empty log.${ColorReset}"
        : > "$outfile"
    else
        mv "$outfile.tmp" "$outfile"
    fi
    echo -e "${IGreen}Black segments written to ${outfile}${ColorReset}"
    echo
}

# ---------- turn black segments into clip boundaries ----------
fnIdentifyClips() {
    local infile="$1"
    local blacklog="$2"
    local cliplog="$3"

    local fps duration nframes
    fps=$(fnGetFPS "$infile")
    duration=$(fnGetDuration "$infile")
    # rough frame count for last-clip end
    nframes=$(bc -l <<< "$duration * $fps" 2>/dev/null || echo 0)

    : > "$cliplog"
    local clip=0
    local prev_end=0

    # midpoints of black segments become the cut points
    while read -r start end dur; do
        [[ -z "${start:-}" ]] && continue
        local mid
        mid=$(bc -l <<< "($start + $end) / 2")
        clip=$((clip + 1))
        local cfill
        cfill=$(printf "%03d" "$clip")

        local fstart fstop tstart tstop
        fstart=$(printf "%.0f" "$(bc -l <<< "$prev_end * $fps" 2>/dev/null || echo 0)")
        fstop=$(printf "%.0f" "$(bc -l <<< "$mid * $fps" 2>/dev/null || echo 0)")
        tstart=$(printf "%013.6f" "$prev_end")
        tstop=$(printf "%013.6f" "$mid")

        echo "Clip:$cfill fStart:$fstart fStop:$fstop tStart:$tstart tStop:$tstop" >> "$cliplog"
        echo -e "${IWhite}Clip ${ICyan}$cfill${IWhite}  ${IGreen}$tstart${IWhite} → ${IRed}$tstop${ColorReset}"

        prev_end=$mid
    done < "$blacklog"

    # final clip to end of file
    clip=$((clip + 1))
    local cfill
    cfill=$(printf "%03d" "$clip")
    local tstart tstop
    tstart=$(printf "%013.6f" "$prev_end")
    tstop=$(printf "%013.6f" "$duration")
    echo "Clip:$cfill fStart:0 fStop:0 tStart:$tstart tStop:$tstop" >> "$cliplog"
    echo -e "${IWhite}Clip ${ICyan}$cfill${IWhite}  ${IGreen}$tstart${IWhite} → ${IRed}$tstop${ColorReset} (to end)"
    echo
}

# ---------- generate LQ clips (multi-threaded FFmpeg, sequential) ----------
fnGenerateLQClips() {
    local infile="$1"
    local cliplog="$2"
    local outdir="$3"

    mkdir -p "$outdir"
    echo -e "${IWhite}Generating LQ preview clips into ${ICyan}$outdir${ColorReset}"

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local clip tstart tstop
        clip=$(echo "$line" | grep -oP '(?<=Clip:).*' | cut -f1 -d' ')
        tstart=$(echo "$line" | grep -oP '(?<=tStart:).*' | cut -f1 -d' ')
        tstop=$(echo "$line" | grep -oP '(?<=tStop:).*' | cut -f1 -d' ')

        local length
        length=$(bc -l <<< "$tstop - $tstart")
        local outfile="${outdir}/LQ_Clip${clip}_${tstart}-${tstop}.mp4"

        echo -e "${IGreen}LQ Clip $clip${ColorReset}  ${tstart}–${tstop} (${length}s)"
        # Fast keyframe seek, then a short accurate seek so the cut is not GOP-aligned.
        # FFmpeg uses all cores (-threads 0). One encode at a time.
        local pre=10
        local prestart="$tstart"
        local acc=0
        if (( $(bc -l <<< "$tstart >= $pre") )); then
            prestart=$(bc -l <<< "$tstart - $pre")
            acc=$pre
        else
            prestart=0
            acc=$tstart
        fi
        ffmpeg -nostdin -hide_banner -stats -loglevel error \
            -ss "$prestart" -i "$infile" -ss "$acc" -t "$length" \
            -threads 0 -c:v libx264 -preset ultrafast \
            -vf "scale=-2:180" -crf 28 -movflags +faststart \
            -c:a copy -y "$outfile" || echo -e "${IRed}Failed: $outfile${ColorReset}"
    done < "$cliplog"
    echo
}

# ---------- emit HQ launcher ----------
# The real encode is h264BlackFrameCompile, which keeps only the LQ
# previews you did not delete. This file is just a launcher so the
# thing sitting in the work directory does that, with no arguments.
fnEmitHQScript() {
    local infile="$1"
    local cliplog="$2"
    local hqscript="$3"
    local outdir="$4"

    cat > "$hqscript" << 'EOF'
#!/bin/sh
# Delete the LQ previews you do not want, then run this.
# It encodes the clips still in lq_previews into <source>.h264.mp4.
cd "$(dirname "$0")" || exit 1
if ! command -v h264BlackFrameCompile >/dev/null 2>&1; then
    echo "h264BlackFrameCompile is not on PATH." >&2
    echo 'git -C "$HOME/bin" fetch origin && git -C "$HOME/bin" reset --hard origin/main' >&2
    exit 1
fi
exec h264BlackFrameCompile .
EOF
    chmod +x "$hqscript"
    echo -e "${IGreen}HQ launcher written: ${ICyan}$hqscript${ColorReset}"
    echo -e "After deleting unwanted previews: ${IYellow}sh $hqscript${ColorReset}"
    echo
}

# ---------- main ----------
fnDisplayRevision
fnDepCheck

if [[ $# -lt 1 ]]; then
    echo -e "${IRed}Usage: $0 <video-file>${ColorReset}"
    exit 1
fi

INFILE="$1"
if [[ ! -f "$INFILE" ]]; then
    echo -e "${IRed}File not found: $INFILE${ColorReset}"
    exit 1
fi

BASE=$(basename "$INFILE")
BNAME="${BASE%.*}"
INFILE=$(readlink -f "$INFILE")
WORKDIR="${BNAME}_work"
mkdir -p "$WORKDIR"
cd "$WORKDIR"

# copy (don't move) so original stays put
if [[ ! -f "$BASE" ]]; then
    cp -v "$INFILE" "./$BASE"
fi
INFILE="./$BASE"

BLACKLOG="${BNAME}_black.log"
CLIPLOG="${BNAME}_clips.log"
LQDIR="lq_previews"
HQSCRIPT="${BNAME}_hq.sh"

fnDetectBlackSegments "$INFILE" "$BLACKLOG"
fnIdentifyClips "$INFILE" "$BLACKLOG" "$CLIPLOG"
fnGenerateLQClips "$INFILE" "$CLIPLOG" "$LQDIR"
fnEmitHQScript "$INFILE" "$CLIPLOG" "$HQSCRIPT" "hq_clips"

echo -e "${IGreen}Done.${ColorReset}"
echo -e "LQ previews: ${ICyan}$WORKDIR/$LQDIR${ColorReset}"
echo -e "HQ script:   ${ICyan}$WORKDIR/$HQSCRIPT${ColorReset}"
echo -e "Black log:   ${ICyan}$WORKDIR/$BLACKLOG${ColorReset}"
echo -e "Clip log:    ${ICyan}$WORKDIR/$CLIPLOG${ColorReset}"
echo
echo -e "${IWhite}Review the LQ clips, delete what you don't want, then run h264BlackFrameCompile in the work directory.${ColorReset}"
