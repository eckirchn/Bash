function fnGenerateFFREPORT()
{
	local _iFile="$1"
	local _oFileLogRaw="$2"
	local _ts=$(date "+%Y%m%d%H%M%S%3N")
	local _tmpLogFile="FFPROBE-"$_ts".tmp"

	BlackframeAmount=99
	BlackframeThreshold=32

	echo -e "Starting FFProbe for Frame Details"
	echo
	echo

	# Clear any existing log file from Previous Run
	if [ -f "$_oFileLogRaw" ]; then
		rm "$_oFileLogRaw" 2>&1
	fi

	#  Scan Video for Black Frames with ffmpeg.
	#  Log level of AV_LOG_INFO minimum required to obtain resulting data

	#	-vf blackframe=amount=98:threshold=32

	FFREPORT=file=$_tmpLogFile:level=$AV_LOG_INFO \
		ffmpeg -hide_banner \
		-threads 0 \
		-i "$iFile" \
		-vf blackframe=amount=$BlackframeAmount:threshold=$BlackframeThreshold \
		-an \
		-f null \
		- 2>&1

	mv -f "$_tmpLogFile" "$_oFileLogRaw"
}

function fnParseBlackFrameLogFile()
{
	local _iLogFile="$1"
	local _oLogFile="$2"

	local _LastFrame=-1
	local _nBlackFrames=0
	local _nClip=0

	local _BlackStart=""
	local _BlackStartFilled=""
	local _BlackEnd=""
	local _BlackFilled=""
	local _nBlackFramesFilled=""
	local _nClipFilled=""
	local _rLine=""
	local _rLineFrame=""
	local _FramesSinceLastrLine=""


	if [ -f "$_oLogFile" ]; then
		rm -Rf "$_oLogFile"
	fi

	echo

	# Loop Through ffmpeg Report Log for Black Frame Information
	while IFS='' read -r _rLine; do
		# Extract data from current Black Frame
		_rLineFrame=$(echo $_rLine |  grep -oP '(?<=frame:).*' | cut -f1 -d ' ')

		if [ "$_rLineFrame" != "" ] ; then
#			echo "_rLineFrame=\""$_rLineFrame"\""

			# Check to see if the Current Frame is the Start of a Black Segment
			_FramesSinceLastrLine=$((_rLineFrame-_LastFrame))

#			echo "rLineFrame:"$_rLineFrame", _LastFrame:"$_LastFrame", _nBlackFrames:"$_nBlackFrames
			if (( $(bc -l <<< "$_FramesSinceLastrLine > 1") )); then
				if [ "$_LastFrame" != "-1" ]; then
					_nClip=$((_nClip+1))
					_nClipFilled=$(printf "%03d\n" $_nClip)

					# Set LastFrame on the first found Black Frame
					_BlackStart=$((_LastFrame-_nBlackFrames+1))
					_BlackStartFilled=$(printf "%07d\n" $_BlackStart)
					_BlackEnd=$_LastFrame
					_BlackEndFilled=$(printf "%07d\n" $_BlackEnd)

#					echo "rLineFrame:"$_rLineFrame", _LastFrame:"$_LastFrame", _nBlackFrames:"$_nBlackFrames", _BlackStart:"$_BlackStart", _BlackEnd:"$_BlackEnd
					echo -e $IWhite"Black Section "$ICyan$_nClipFilled\
						$IWhite"from "$IYellow$_BlackStartFilled$IWhite" to "$IYellow$_BlackEndFilled\
						$IWhite"("$IBlue$_nBlackFramesFilled$IWhite" Frames)"$ColorReset

					echo "BlackSegment:"$_nClipFilled" BlackStart:"$_BlackStartFilled\
						" BlackEnd:"$_BlackEndFilled" nFrames:"$_nBlackFramesFilled >> "$_oLogFile"

					_nBlackFrames=0
#					sleep 5
				fi
			fi
			_LastFrame=$_rLineFrame
			_nBlackFrames=$((_nBlackFrames+1))
			_nBlackFramesFilled=$(printf "%03d\n" $_nBlackFrames)
		fi
	done < "$_iLogFile"

	_nClip=$((_nClip+1))
	_nClipFilled=$(printf "%03d\n" $_nClip)

	_BlackStart=$((_LastFrame-_nBlackFrames+1))
	_BlackStartFilled=$(printf "%07d\n" $_BlackStart)
	_BlackEnd=$_LastFrame
	_BlackEndFilled=$(printf "%07d\n" $_BlackEnd)

#	echo -e $IWhite"Black Section "$ICyan$_nClipFilled\
#		$IWhite"from "$IYellow$_BlackStartFilled$IWhite" to "$IYellow$_BlackEndFilled\
#		$IWhite"("$IBlue$_nBlackFramesFilled$IWhite" Frames)"$ColorReset
#	echo -e $IWhite"BlackSegment:"$ICyan$_nClipFilled$IWhite" BlackStart:"$ICyan$_BlackStartFilled$IWhite\
#		$IWhite" BlackEnd:"ICyan$_BlackEndFilled$IWhite" nFrames:"$ICyan$_nBlackFramesFilled$ColorReset >> "$_oLogFile"

	echo -e $IWhite"Black Section "$ICyan$_nClipFilled\
		$IWhite"from "$IYellow$_BlackStartFilled$IWhite" to "$IYellow$_BlackEndFilled\
		$IWhite"("$IBlue$_nBlackFramesFilled$IWhite" Frames)"$ColorReset

	echo "BlackSegment:"$_nClipFilled" BlackStart:"$_BlackStartFilled\
		" BlackEnd:"$_BlackEndFilled" nFrames:"$_nBlackFramesFilled >> "$_oLogFile"

	echo
	echo -e $IWhite"Found "$IYellow$_nClipFilled$IWhite" Black Segments"$ColorReset
	echo
}

function fnIdentifyClips()
{
	local _iFile="$1"
	local _iLogFile="$2"
	local _oLogFile="$3"


	local _cmd_vFPS=""
	local _cmd_nFrames=""
	local _vFPS=0
	local _vFPS_Float=0.0
	local _nFrames=0
	
	local _nClip=0
	local _flgFirstLine=1

	local _nClipFilled=""
	local _rLine=""
	local _rLineFrame=""
	local _rLineBlackStart=""
	local _rLineBlackEnd=""
	local _rLineFrames=""
	local _SplitFrame=""
	local _SplitFrameReal=""
	local _fClipStart=""
	local _fClipEnd=""
	local _tClipStart=""
	local _tClipEnd=""


	if [ -f "$_oLogFile" ]; then
		rm -Rf "$_oLogFile" 2>&1
	fi

	# Scan for Framerate and Duration used for calculations
	_cmd_vFPS="ffprobe -i \"$_iFile\" -select_streams v:0 -show_entries stream=r_frame_rate -v quiet -of csv=\"p=0\""
	_vFPS=$(eval $_cmd_vFPS)
	_vFPS_Float=$(bc -l <<< "$_vFPS")

	_cmd_nFrames="ffprobe -i \"$_iFile\" -select_streams v:0 -show_entries stream=nb_frames -v quiet -of csv=\"p=0\""
	_nFrames=$(eval $_cmd_nFrames)


	# Loop Through ffmpeg Report Log for Black Frame Information
	while IFS='' read -r _rLine; do
		echo
		echo -e "Processing Line: [ "$IYellow$_rLine$ColorReset" ]"

		# Extract data from Read Line
		_rLineBlackStart=$(echo $_rLine |  grep -oP '(?<=BlackStart:).*' | cut -f1 -d ' ')
		_rLineBlackEnd=$(echo $_rLine |  grep -oP '(?<=BlackEnd:).*' | cut -f1 -d ' ')
		_rLineFrames=$(echo $_rLine |  grep -oP '(?<=nFrames:).*' | cut -f1 -d ' ')

		if [ $(( $((10#$_rLineFrames)) % 2)) -eq 0 ]; then
			# Number is Even
			_SplitFrameReal=$(bc -l <<< "(($_rLineFrames) / 2) + $_rLineBlackStart")
		else
			# Number is Odd
			_SplitFrameReal=$(bc -l <<< "(($_rLineFrames - 1) / 2) + $_rLineBlackStart")
		fi
		_SplitFrame=${_SplitFrameReal%.*}

		echo -e $IWhite"  Using Split Frame: "$ICyan$_SplitFrame$ColorReset

		_nClip=$((_nClip+1))
		_nClipFilled=$(printf "%03d\n" $_nClip)

		if (( $_flgFirstLine )); then
			_flgFirstLine=0

			_fClipStart=0
			_tClipStart=$(bc -l <<< "$_fClipStart / $_vFPS_Float")
			_tClipStart=$(printf "%013.6f\n" $_tClipStart)
		else

			_fClipStart=$(($_fClipEnd+1))
			_tClipStart=$(bc -l <<< "$_fClipStart / $_vFPS_Float")
			_tClipStart=$(printf "%013.6f\n" $_tClipStart)
		fi

		_fClipEnd=$(($_SplitFrame))
		_tClipEnd=$(bc -l <<< "$_fClipEnd / $_vFPS_Float")
		_tClipEnd=$(printf "%013.6f\n" $_tClipEnd)

		echo -e $IWhite"    Clip: "$ICyan$_nClipFilled$IWhite", Frame Start: "$IGreen$_fClipStart$IWhite", Stop: "$IRed$_fClipEnd$ColorReset
		echo -e $IWhite"    Clip: "$ICyan$_nClipFilled$IWhite", Time Start: "$IGreen$_tClipStart$IWhite", Stop: "$IRed$_tClipEnd$ColorReset
		echo "Clip:"$_nClipFilled" fStart:"$_fClipStart" fStop:"$_fClipEnd\
			"tStart:"$_tClipStart" tStop:"$_tClipEnd >> "$_oLogFile"

	done < "$_iLogFile"

	# Add Clip from Last Black Split to End of Video
	echo
	echo -e $IWhite"Processing Last Clip:"$ColorReset

	_nClip=$((_nClip+1))
	_nClipFilled=$(printf "%03d\n" $_nClip)

	_fClipStart=$(($_fClipEnd+1))
	_tClipStart=$(bc -l <<< "$_fClipStart / $_vFPS_Float")
	_tClipStart=$(printf "%013.6f\n" $_tClipStart)

	_fClipEnd=$(($_nFrames))
	_tClipEnd=$(bc -l <<< "$_fClipEnd / $_vFPS_Float")
	_tClipEnd=$(printf "%013.6f\n" $_tClipEnd)

	echo -e "    Clip:"$ICyan$_nClipFilled$ColorReset", Frame Start:"$IGreen$_fClipStart$ColorReset", Stop:"$IRed$_fClipEnd$ColorReset
	echo -e "    Clip:"$ICyan$_nClipFilled$ColorReset", Time Start:"$IGreen$_tClipStart$ColorReset", Stop:"$IRed$_tClipEnd$ColorReset
	echo "Clip:"$_nClipFilled" fStart:"$_fClipStart" fStop:"$_fClipEnd\
		"tStart:"$_tClipStart" tStop:"$_tClipEnd >> "$_oLogFile"

	echo
	echo -e "Identified "$IYellow$_nClipFilled$ColorReset" Clips"
	echo
}

