function fnCPULoad {
	# by Paul Colby (http://colby.id.au)
   	PREV_TOTAL=0
	PREV_IDLE=0
	TOTAL=0

	# Get the total CPU statistics, discarding the 'cpu ' prefix.
	CPU=(`sed -n 's/^cpu\s//p' /proc/stat`)
	IDLE=${CPU[3]} # Just the idle CPU time.

	# Calculate the total CPU time.
	TOTAL=0
	for i in "${CPU[@]}"; do
	  let "TOTAL=$TOTAL+$i"
	done

	# Remember the total and idle CPU times for the next check.
	PREV_TOTAL="$TOTAL"
	PREV_IDLE="$IDLE"

	sleep 1

	# Get the total CPU statistics, discarding the 'cpu ' prefix.
	CPU=(`sed -n 's/^cpu\s//p' /proc/stat`)
	IDLE=${CPU[3]} # Just the idle CPU time.

	# Calculate the total CPU time.
	TOTAL=0
	for i in "${CPU[@]}"; do
	  let "TOTAL=$TOTAL+$i"
	done

	# Calculate the CPU usage since we last checked.
	let "DIFF_USAGE=(1000*(($TOTAL-$PREV_TOTAL)-($IDLE-$PREV_IDLE))/($TOTAL-$PREV_TOTAL+5))/10"

	echo $DIFF_USAGE
	fnCPULoad=$DIFF_USAGE
}


function fnCPUSleep {
	local _flagHighLoad=1
	local _limitCPU=90
	local _tAverage=3
	local _nSamples=0
	local _tCPULoad=0
	local _start=0
	local _now=0
	local _avgCPULoad=0
	local _runtime=0
	local _preset=""
	local _vfScale=""
	local _crf=0

	echo -e $IWhite"  Watching Average CPU Load to drop below "$ICyan$_limitCPU$IWhite"%"
	_start=`date +%s.%N`

	while [ "$_flagHighLoad" -ne "0" ]; do
		_nSamples=$((_nSamples+1))

		_CPULoad=$(fnCPULoad)
		_tCPULoad=$(bc -l <<< "($_tCPULoad + $_CPULoad)")
		_avgCPULoad=$(bc -l <<< "($_tCPULoad / $_nSamples)")

		echo -ne "\r$IRed    $(printf "%.*f\n" 2 $_avgCPULoad)$ColorReset% - Waiting $IGreen$_tAverage$ColorReset seconds ($IGreen$(printf "%03.0f\n" $_runtime)$ColorReset)"

		_now=`date +%s.%N`
		_runtime=$(bc -l <<< "($_now - $_start)")

		if (( $(bc -l <<< "$_runtime > $_tAverage" ) )); then
			echo -ne "\r$IRed    $(printf "%.*f\n" 2 $_avgCPULoad)$ColorReset% - Waiting $IGreen$_tAverage$ColorReset seconds ($IGreen$(printf "%03.0f\n" $_runtime)$ColorReset)"
			_start=`date +%s`
			_tCPULoad=0
			_nSamples=0
			_flagHighLoad=$(bc -l <<< "$_avgCPULoad > $_limitCPU")
		fi
	done
	echo
	echo
}


function fnDefineFFmpegLogLevels ()
{
	# Define FFmpeg Log levels 
	# Taken from https://lists.ffmpeg.org/pipermail/ffmpeg-user/2014-November/024158.html
	# Possible levels are numbers or:
		# -8	"quiet"
		# 0		"panic"
		# 8		"fatal"
		# 16	"error"
		# 24	"warning"
		# 32	"info"
		# 40	"verbose"
		# 48	"debug"
		# "trace"

	AV_LOG_QUIET=-8
	AV_LOG_PANIC=0
	AV_LOG_FATAL=8
	AV_LOG_ERROR=16
	AV_LOG_WARNING=24
	AV_LOG_INFO=32
	AV_LOG_VERBOSE=40
	AV_LOG_DEBUG=48
}


function fnSetupClipScripts()
{
	_oFileGenClipsScript_LQ="$1"
	_oFileGenClipsScript_HQ="$2"

	if [ -f "$_oFileGenClipsScript_LQ" ]; then
		rm "$_oFileGenClipsScript_LQ"
	fi

	if [ -f "$_oFileGenClipsScript_HQ" ]; then
		rm "$_oFileGenClipsScript_HQ"
	fi

	# Start of Clip Generation Common Header Content
	# Setup Generate Clips Script Header
	local _strUseAWK1=$(echo '{usage=($2+$3+$4)} END {print usage}')
	local _strTotalAWK1=$(echo '{usage=($2+$3+$4+$5)} END {print usage}')

	local _strUseAWK2=$(echo "awk '$_strUseAWK1'")
	local _strTotalAWK2=$(echo "awk '$_strTotalAWK1'")

	local _strCmdUse=$(echo "grep \"cpu \" /proc/stat | $_strUseAWK2")
	local _strCmdTotal=$(echo "grep \"cpu \" /proc/stat | $_strTotalAWK2")


	# Setup the common headers for the Clip Generation Scripts
	echo "#!/bin/bash" >> "$_oFileGenClipsScript_LQ"

	# Write CPUSleep() Function
	echo 'function CPUSleep()' >> "$_oFileGenClipsScript_LQ"
	echo '{' >> "$_oFileGenClipsScript_LQ"

	echo '	cpuload=100' >> "$_oFileGenClipsScript_LQ"
	echo '	echo "  Watching CPU Load to drop below 90%"' >> "$_oFileGenClipsScript_LQ"
	echo '	while (( $(bc -l <<< "$cpuload > 90") )); do' >> "$_oFileGenClipsScript_LQ"

	echo '	UseSample1=$(\'>> "$_oFileGenClipsScript_LQ"
	echo "	$_strCmdUse)" >> "$_oFileGenClipsScript_LQ"

	echo '	TotalSample1=$(\'>> "$_oFileGenClipsScript_LQ"
	echo "	$_strCmdTotal)" >> "$_oFileGenClipsScript_LQ"

	echo '	sleep 2' >> "$_oFileGenClipsScript_LQ"

	echo '	UseSample2=$(\'>> "$_oFileGenClipsScript_LQ"
	echo "	$_strCmdUse)" >> "$_oFileGenClipsScript_LQ"

	echo '	TotalSample2=$(\'>> "$_oFileGenClipsScript_LQ"
	echo "	$_strCmdTotal)" >> "$_oFileGenClipsScript_LQ"

	echo '	cpuload=$(echo "($UseSample2-$UseSample1)/($TotalSample2-$TotalSample1)*100" | bc -l)' >> "$_oFileGenClipsScript_LQ"
	echo '	echo -ne "\e[0K\r""\033[0;91m    $(printf "%.*f\n" 2 $cpuload)%\033[0m"' >> "$_oFileGenClipsScript_LQ"
	echo '	sleep 2' >> "$_oFileGenClipsScript_LQ"
	echo '	done' >> "$_oFileGenClipsScript_LQ"
	echo '}' >> "$_oFileGenClipsScript_LQ"
	echo "" >> "$_oFileGenClipsScript_LQ"

	#Write File Information for ffmpeg Commands
	echo 'iFile="$1"' >> "$_oFileGenClipsScript_LQ"
	echo 'iFname=$(basename "$iFile")' >> "$_oFileGenClipsScript_LQ"
	echo 'iFbname=${iFname%.*}' >> "$_oFileGenClipsScript_LQ"
	echo 'oClipDir=$(basename "$iFbname")' >> "$_oFileGenClipsScript_LQ"
	echo  >> "$_oFileGenClipsScript_LQ"
	echo 'if [ ! -d "$oClipDir" ]; then' >> "$_oFileGenClipsScript_LQ"
	echo '  mkdir "$oClipDir"' >> "$_oFileGenClipsScript_LQ"
	echo 'else' >> "$_oFileGenClipsScript_LQ"
	echo '  rm -Rfv "$oClipDir\*"' >> "$_oFileGenClipsScript_LQ"
	echo 'fi' >> "$_oFileGenClipsScript_LQ"
	echo  >> "$_oFileGenClipsScript_LQ"

	cp "$_oFileGenClipsScript_LQ" "$_oFileGenClipsScript_HQ"

	# End of Clip Generation Common Header Content}
}

