#!/bin/bash

function fnDisplayRevision()
{
#  Set Script Revision
	REV="20190126_1116"
	echo -e $IWhite"Script Revision:  "$IYellow$REV$ColorReset
	echo -e $IPurple"  Initial Release"$ColorReset
	echo -e

	sleep 1
}

