}


function fnDepCheck ()
{
# Check for Dependencies
	flgDepCheck=0
	echo -e $IWhite"Running Dependency Check$ColorReset"

	# Check for "fpaste"
	if type fpaste >/dev/null; then
	  echo -e "  fpaste:$IGreen\t\tOK$ColorReset"
	else
		echo -e "  Dependencies Failed:$IRed  \"fpaste\" not installed$ColorReset"
		echo -e "  Execute:$IGreen dnf install fpaste"$ColorReset
		flgDepCheck=1
	fi

	# Exit on Dependencies Fail
	if [ $flgDepCheck -ne 0 ]; then
		echo -e "$IRed  Some Dependencies Failed!$ColorReset"
		echo -e "  See the Text Displayed Above."
		echo
		exit
	fi

 	echo -e "$IWhite""Dependency Check:$IGreen Done$ColorReset"; echo
}


#********************************************************************************
#  Start of Script Code
#********************************************************************************

#clear
echo
fnDefineANSIColorCodes
fnDisplayRevision
fnDepCheck

server="$1" 
keyname="id_rsa.$server" 
keypath="/home/$USER/.ssh"
configfile="$keypath/config"

if ! [ -f $configfile ]; then
	touch "$configfile"
	chmod 644 "$configfile"
fi

echo -e
if [ -f $keypath/$keyname ]; then
	echo -e $IRed"Key Exists.  "$IYellow"Using existing key"$ColorReset
	echo -e
else
	yes n|ssh-keygen -t rsa -b 4096 -C "$USER@$HOSTNAME" -N "" -f "$keypath/$keyname"
	echo -e $ICyan"n"$ColorReset # for visual effect
	echo -e 

	echo ""  >> "$configfile"
	echo "Host "$server >> "$configfile"
	echo "  HostName "$server >> "$configfile"
	echo "  IdentityFile "$keypath/$keyname >> "$configfile"
	echo "  User "$USER  >> "$configfile"
fi

echo -e $IGreen"Trying to add key to "$ICyan$keypath"/authorized_keys"$ColorReset
ssh-copy-id -i "$keypath/$keyname.pub" $USER@$server #Attempt to add key to 

retVal=$?
if [ $retVal -ne 0 ]; then
    echo -e
    echo -e $IRed"Automatic additon to server failed, add the key manually."$ColorReset
	echo -e 
	echo -e $IGreen"Public Key:"$ColorReset
	echo -e
	echo -e $ICyan$(cat "$keypath/$keyname.pub")$ColorReset
	echo -e 
	fpaste "$keypath/$keyname.pub"
else
	echo -e 
	echo -e $IRed"Reminder"$ColorReset
	echo -e $IWhite"  Update "$ICyan"/etc/ssh/sshd_config"$ColorReset
	echo -e $IYellow"    PasswordAuthentication "$IRed"no"$ColorReset
	echo -e $IYellow"    ChallengeResponseAuthentication "$IRed"no"$ColorReset
	echo -e $IYellow"    UsePAM "$IRed"no"$ColorReset
	echo -e 
fi
