#!/bin/bash
# Updated: 24 October 2026, 3:07 AM MDT
# h264BlackFrameCompile / h265BlackFrameCompile
# After reviewing lq_previews, delete the clips you do not want.
# This script encodes whatever is still there, in clip order, into one file.
#
#   h264BlackFrameCompile [work-directory]
#   h265BlackFrameCompile [work-directory]
#
# work-directory is the folder blackframeextract made (MyClip/),
# or an older MyClip_work folder. Default is the current directory.
#
# Output sits next to the source copy:
#   <name>.h264.mp4
#   <name>.h265.mp4
#
# E5-2680 (Sandy Bridge, 8c/16t, no hardware encoder). One encode at a time
# so x264/x265 can use every thread.
#
# x264: preset slow, tune film, CRF 18, high profile, 8-bit.
#   slow is the quality/time knee on this CPU. veryslow is not worth it.
# x265: preset medium, CRF 20, main10, SAO off, aq-mode 3.
#   CRF 20 is about the same picture as x264 CRF 18, in fewer bits.
#   10-bit avoids banding. medium is the usable preset here; slow is ~1-3 fps.

set -euo pipefail

ColorReset='\033[0m'
IWhite='\033[0;97m'
IYellow='\033[0;93m'
ICyan='\033[0;96m'
IGreen='\033[0;92m'
IRed='\033[0;91m'

CODEC=h264
if [[ "${1:-}" == "--hevc" || "${1:-}" == "--h265" ]]; then
    CODEC=hevc
    shift
fi

fnDie() {
    echo -e "${IRed}$*${ColorReset}" >&2
    exit 1
}

for cmd in ffmpeg ffprobe bc; do
    command -v "$cmd" >/dev/null 2>&1 || fnDie "missing: $cmd"
done

WORKDIR=$(readlink -f "${1:-.}")
LQDIR="$WORKDIR/lq_previews"
[[ -d "$LQDIR" ]] || fnDie "No lq_previews in $WORKDIR"

fnFindSource() {
    local dir="$1"
    local stem ext f base
    stem=$(basename "$dir")
    stem=${stem%_work}
    for ext in mp4 mkv m4v mov ts avi mpg mpeg; do
        f="$dir/$stem.$ext"
        if [[ -f "$f" ]]; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    local -a found=()
    shopt -s nullglob
    for f in "$dir"/*.{mp4,mkv,m4v,mov,ts,avi,mpg,mpeg}; do
        base=$(basename "$f")
        [[ "$base" == *.clean.* || "$base" == *.h264.mp4 || "$base" == *.h265.mp4 ]] && continue
        found+=("$f")
    done
    shopt -u nullglob
    if (( ${#found[@]} == 1 )); then
        printf '%s\n' "${found[0]}"
        return 0
    fi
    if (( ${#found[@]} == 0 )); then
        fnDie "No source video in $dir"
    fi
    fnDie "More than one source video in $dir; use a folder named after the source"
}

SOURCE=$(fnFindSource "$WORKDIR")
STEM=$(basename "$SOURCE")
STEM=${STEM%.*}

if [[ "$CODEC" == hevc ]]; then
    CRF=20
    PRESET=medium
    LABEL="x265 main10 ${PRESET} CRF ${CRF}"
    OUTPUT="$WORKDIR/${STEM}.h265.mp4"
    SEGDIR="$WORKDIR/hq_segments_h265"
    VCODEC=(
        -c:v libx265
        -preset "$PRESET"
        -crf "$CRF"
        -pix_fmt yuv420p10le
        -profile:v main10
        -tag:v hvc1
        -x265-params "aq-mode=3:qg-size=32:psy-rd=2.0:psy-rdoq=1.0:rdoq-level=2:deblock=-1,-1:sao=0:strong-intra-smoothing=0:bframes=6:rc-lookahead=40:ref=4"
    )
else
    CRF=18
    PRESET=slow
    LABEL="x264 ${PRESET} tune film CRF ${CRF}"
    OUTPUT="$WORKDIR/${STEM}.h264.mp4"
    SEGDIR="$WORKDIR/hq_segments"
    VCODEC=(
        -c:v libx264
        -preset "$PRESET"
        -tune film
        -crf "$CRF"
        -profile:v high
        -pix_fmt yuv420p
    )
fi

ROWS_FILE=$(mktemp)
trap 'rm -f "$ROWS_FILE"' EXIT
shopt -s nullglob
for f in "$LQDIR"/LQ_Clip*.mp4; do
    base=$(basename "$f" .mp4)
    if [[ "$base" =~ ^LQ_Clip([0-9]+)_([0-9]+\.[0-9]+)-([0-9]+\.[0-9]+)$ ]]; then
        id=$((10#${BASH_REMATCH[1]}))
        printf '%s\t%s\t%s\n' "$id" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    else
        echo -e "${IYellow}skip (bad name): $(basename "$f")${ColorReset}" >&2
    fi
done > "$ROWS_FILE"
sort -n -k1,1 -o "$ROWS_FILE" "$ROWS_FILE"
mapfile -t ROWS < "$ROWS_FILE"
shopt -u nullglob

if (( ${#ROWS[@]} == 0 )); then
    fnDie "No LQ clips left in $LQDIR"
fi

echo -e "${IWhite}Source:${ColorReset}  $SOURCE"
echo -e "${IWhite}Output:${ColorReset}  $OUTPUT"
echo -e "${IWhite}Keeping ${ICyan}${#ROWS[@]}${IWhite} clip(s), ${LABEL}, one encode at a time${ColorReset}"

total=0
for row in "${ROWS[@]}"; do
    IFS=$'\t' read -r id start stop <<<"$row"
    len=$(bc -l <<< "$stop - $start")
    total=$(bc -l <<< "$total + $len")
    printf '  Clip %03d  %s -> %s  (%ss)\n' "$id" "$start" "$stop" "$len"
done
printf '  Total kept: %ss\n\n' "$total"

rm -rf "$SEGDIR"
mkdir -p "$SEGDIR"
LIST="$SEGDIR/concat.txt"
: > "$LIST"

for row in "${ROWS[@]}"; do
    IFS=$'\t' read -r id start stop <<<"$row"
    idpad=$(printf '%03d' "$id")
    len=$(bc -l <<< "$stop - $start")
    pre=10
    if (( $(bc -l <<< "$start >= $pre") )); then
        prestart=$(bc -l <<< "$start - $pre")
        acc=$pre
    else
        prestart=0
        acc=$start
    fi
    seg="$SEGDIR/HQ_Clip${idpad}.mp4"
    echo -e "${IGreen}HQ Clip $idpad${ColorReset}  ${start}–${stop} (${len}s)"
    ffmpeg -nostdin -hide_banner -stats -loglevel error \
        -ss "$prestart" -i "$SOURCE" -ss "$acc" -t "$len" \
        -threads 0 \
        -map 0:v:0 -map 0:a? \
        "${VCODEC[@]}" \
        -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv \
        -c:a copy \
        -avoid_negative_ts make_zero \
        -movflags +faststart \
        -y "$seg"
    escaped=${seg//\'/\'\\\'\'}
    printf "file '%s'\n" "$escaped" >> "$LIST"
done

echo -e "${IWhite}Joining segments -> ${ICyan}$OUTPUT${ColorReset}"
ffmpeg -nostdin -hide_banner -stats -loglevel error \
    -f concat -safe 0 -i "$LIST" \
    -c copy -movflags +faststart \
    -y "$OUTPUT"

rm -rf "$SEGDIR"
echo -e "${IGreen}Done:${ColorReset} $OUTPUT"
