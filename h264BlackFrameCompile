#!/bin/bash
# h264BlackFrameCompile
# After reviewing lq_previews, delete the clips you do not want.
# This script encodes whatever is still there, in clip order, into one file.
#
#   h264BlackFrameCompile [work-directory]
#
# work-directory is the *_work folder from h264BlackFrameExtract.
# Default is the current directory.
#
# Source is the video copied into that folder
#   (Meet Joe Black (1998) 1080p STARZ SRC_work/Meet Joe Black ....mp4).
# Output is the same name with .clean.mp4 in that same folder.
#
# Only files present in lq_previews are kept. A missing clip is a deleted clip.
# Timestamps come from the filename, not from how long the preview plays.

set -euo pipefail

ColorReset='\033[0m'
IWhite='\033[0;97m'
IYellow='\033[0;93m'
ICyan='\033[0;96m'
IGreen='\033[0;92m'
IRed='\033[0;91m'

CRF=18
PRESET=medium

fnDie() {
    echo -e "${IRed}$*${ColorReset}" >&2
    exit 1
}

for cmd in ffmpeg ffprobe bc; do
    command -v "$cmd" >/dev/null 2>&1 || fnDie "missing: $cmd"
done

WORKDIR=$(readlink -f "${1:-.}")
LQDIR="$WORKDIR/lq_previews"
[[ -d "$LQDIR" ]] || fnDie "No lq_previews in $WORKDIR"

fnFindSource() {
    local dir="$1"
    local stem ext f
    stem=$(basename "$dir")
    stem=${stem%_work}
    for ext in mp4 mkv m4v mov ts avi mpg mpeg; do
        f="$dir/$stem.$ext"
        if [[ -f "$f" ]]; then
            printf '%s\n' "$f"
            return 0
        fi
    done
    local -a found=()
    shopt -s nullglob
    for f in "$dir"/*.{mp4,mkv,m4v,mov,ts,avi,mpg,mpeg}; do
        [[ "$(basename "$f")" == *.clean.* ]] && continue
        found+=("$f")
    done
    shopt -u nullglob
    if (( ${#found[@]} == 1 )); then
        printf '%s\n' "${found[0]}"
        return 0
    fi
    if (( ${#found[@]} == 0 )); then
        fnDie "No source video in $dir"
    fi
    fnDie "More than one source video in $dir; name the folder <source>_work"
}

SOURCE=$(fnFindSource "$WORKDIR")
STEM=$(basename "$SOURCE")
STEM=${STEM%.*}
OUTPUT="$WORKDIR/${STEM}.clean.mp4"
SEGDIR="$WORKDIR/hq_segments"

ROWS_FILE=$(mktemp)
trap 'rm -f "$ROWS_FILE"' EXIT
shopt -s nullglob
for f in "$LQDIR"/LQ_Clip*.mp4; do
    base=$(basename "$f" .mp4)
    if [[ "$base" =~ ^LQ_Clip([0-9]+)_([0-9]+\.[0-9]+)-([0-9]+\.[0-9]+)$ ]]; then
        id=$((10#${BASH_REMATCH[1]}))
        printf '%s\t%s\t%s\n' "$id" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
    else
        echo -e "${IYellow}skip (bad name): $(basename "$f")${ColorReset}" >&2
    fi
done > "$ROWS_FILE"
sort -n -k1,1 -o "$ROWS_FILE" "$ROWS_FILE"
mapfile -t ROWS < "$ROWS_FILE"
shopt -u nullglob

if (( ${#ROWS[@]} == 0 )); then
    fnDie "No LQ clips left in $LQDIR"
fi

echo -e "${IWhite}Source:${ColorReset}  $SOURCE"
echo -e "${IWhite}Output:${ColorReset}  $OUTPUT"
echo -e "${IWhite}Keeping ${ICyan}${#ROWS[@]}${IWhite} clip(s), x264 ${PRESET} CRF ${CRF}, one encode at a time${ColorReset}"

total=0
for row in "${ROWS[@]}"; do
    IFS=$'\t' read -r id start stop <<<"$row"
    len=$(bc -l <<< "$stop - $start")
    total=$(bc -l <<< "$total + $len")
    printf '  Clip %03d  %s -> %s  (%ss)\n' "$id" "$start" "$stop" "$len"
done
printf '  Total kept: %ss\n\n' "$total"

rm -rf "$SEGDIR"
mkdir -p "$SEGDIR"
LIST="$SEGDIR/concat.txt"
: > "$LIST"

for row in "${ROWS[@]}"; do
    IFS=$'\t' read -r id start stop <<<"$row"
    idpad=$(printf '%03d' "$id")
    len=$(bc -l <<< "$stop - $start")
    pre=10
    if (( $(bc -l <<< "$start >= $pre") )); then
        prestart=$(bc -l <<< "$start - $pre")
        acc=$pre
    else
        prestart=0
        acc=$start
    fi
    seg="$SEGDIR/HQ_Clip${idpad}.mp4"
    echo -e "${IGreen}HQ Clip $idpad${ColorReset}  ${start}–${stop} (${len}s)"
    ffmpeg -nostdin -hide_banner -stats -loglevel error \
        -ss "$prestart" -i "$SOURCE" -ss "$acc" -t "$len" \
        -threads 0 \
        -map 0:v:0 -map 0:a? \
        -c:v libx264 -preset "$PRESET" -crf "$CRF" -pix_fmt yuv420p \
        -c:a copy \
        -avoid_negative_ts make_zero \
        -movflags +faststart \
        -y "$seg"
    # concat demuxer wants a single-quoted path; escape any quote in the name
    escaped=${seg//\'/\'\\\'\'}
    printf "file '%s'\n" "$escaped" >> "$LIST"
done

echo -e "${IWhite}Joining segments -> ${ICyan}$OUTPUT${ColorReset}"
ffmpeg -nostdin -hide_banner -stats -loglevel error \
    -f concat -safe 0 -i "$LIST" \
    -c copy -movflags +faststart \
    -y "$OUTPUT"

rm -rf "$SEGDIR"
echo -e "${IGreen}Done:${ColorReset} $OUTPUT"
