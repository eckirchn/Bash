#!/bin/bash
# Updated: 25 November 2026, 12:35 AM MST
# BlackFrameCompileh265Batch
# From the directory you run this in, enter each subdirectory and run
# BlackFrameCompile h265. One folder at a time. A failure is reported
# and the next folder still runs.
#
#   BlackFrameCompileh265Batch
#
# BlackFrameCompile requires the argument h265, not 265.

set -u

ColorReset='\033[0m'
IWhite='\033[0;97m'
IYellow='\033[0;93m'
ICyan='\033[0;96m'
IGreen='\033[0;92m'
IRed='\033[0;91m'

fnDie() {
    echo -e "${IRed}$*${ColorReset}" >&2
    exit 1
}

command -v BlackFrameCompile >/dev/null 2>&1 || fnDie "BlackFrameCompile is not on PATH."

shopt -s nullglob
dirs=(*/)
shopt -u nullglob

if (( ${#dirs[@]} == 0 )); then
    fnDie "No subdirectories here."
fi

failed=0
ran=0
for dir in "${dirs[@]}"; do
    dir=${dir%/}
    [[ "$dir" == .* ]] && continue
    [[ -d "$dir" ]] || continue
    ran=$((ran + 1))
    echo -e "${IWhite}=== ${ICyan}${dir}${ColorReset}"
    if ( cd "$dir" && BlackFrameCompile h265 ); then
        echo -e "${IGreen}Done: ${dir}${ColorReset}"
    else
        echo -e "${IRed}Failed: ${dir}${ColorReset}" >&2
        failed=$((failed + 1))
    fi
    echo
done

if (( ran == 0 )); then
    fnDie "No subdirectories here."
fi

if (( failed > 0 )); then
    fnDie "${failed} of ${ran} folder(s) failed."
fi

echo -e "${IGreen}Finished ${ran} folder(s).${ColorReset}"
